# ---------------------------------------------------------------------------
# start-and-found — local development environment
# Copy to .env and adjust:  cp .env.example .env
# ---------------------------------------------------------------------------

# Application -----------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=debug
HTTP_ADDR=:8080

# PostgreSQL ------------------------------------------------------------------
DATABASE_URL=postgres://saf:saf@localhost:5432/saf?sslmode=disable

# Redis -----------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# Authentication --------------------------------------------------------------
# Must be set to a long random string in production:
#   openssl rand -base64 48
JWT_SECRET=dev-insecure-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Object storage (S3 compatible, MinIO locally) -------------------------------
S3_ENDPOINT=localhost:9000
S3_REGION=us-east-1
S3_BUCKET=saf-media
S3_ACCESS_KEY=safminio
S3_SECRET_KEY=safminio123
S3_USE_SSL=false
S3_PUBLIC_BASE_URL=http://localhost:9000/saf-media

# CORS ------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000

# MinIO container credentials (consumed by docker compose) --------------------
MINIO_ROOT_USER=safminio
MINIO_ROOT_PASSWORD=safminio123

# Web (Next.js) ---------------------------------------------------------------
# Server-side base URL of the Go API.
API_BASE_URL=http://localhost:8080/v1
